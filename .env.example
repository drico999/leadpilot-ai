# ---------- Vercel (website + API) ----------
# Leave the two URLs empty to run the site in demo mode (no backend needed).
N8N_LEAD_WEBHOOK_URL=https://your-n8n-host/webhook/leadpilot/lead
N8N_LEADS_WEBHOOK_URL=https://your-n8n-host/webhook/leadpilot/leads
# Same value as the "LeadPilot webhook key" Header Auth credential in n8n
# (header name: X-LeadPilot-Key). Generate one with: openssl rand -hex 24
N8N_WEBHOOK_SECRET=

# ---------- Workflow build (npm run build:workflows) ----------
OWNER_EMAIL=you@example.com
OWNER_NAME=Andries Mokono
SHEET_ID=YOUR_GOOGLE_SHEET_ID
OPENAI_MODEL=gpt-4.1-mini
TIMEZONE=Africa/Johannesburg

# ---------- Self-hosted n8n (docker compose) ----------
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public base URL n8n uses for webhooks, e.g. https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=Africa/Johannesburg
