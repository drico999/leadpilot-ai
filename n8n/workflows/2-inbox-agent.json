    {
      "parameters": {
        "jsCode": "// n8n Code node: \"Prepare email\" (Run once for all items)\n// Normalises the Gmail Trigger output (simplify = off) for the AI agent.\n\nreturn $input.all().map((item) => {\n  const m = item.json;\n  const fromObj = (m.from && m.from.value && m.from.value[0]) || {};\n  const text = String(m.text || m.textAsHtml || m.snippet || '')\n    .replace(/\\r/g, '')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    // Drop quoted history so the agent reads only the new message.\n    .split(/\\nOn .+wrote:\\n/)[0]\n    .slice(0, 4000);\n\n  return {\n    json: {\n      message_id: m.id,\n      thread_id: m.threadId,\n      from_email: String(fromObj.address || '').toLowerCase(),\n      from_name: String(fromObj.name || ''),\n      subject: String(m.subject || '(no subject)').slice(0, 200),\n      received_at: m.date || new Date().toISOString(),\n      body: text,\n    },\n  };\n});\n"
      },
      "id": "b9cb4091-e413-4761-a0a3-27e6e5cf8479",
      "name": "Prepare email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=New email to triage.\nFrom: {{ $json.from_name }} <{{ $json.from_email }}>\nSubject: {{ $json.subject }}\nThread ID (use for Draft reply): {{ $json.thread_id }}\nReceived: {{ $json.received_at }}\n\nBody:\n\"\"\"\n{{ $json.body }}\n\"\"\"",
        "options": {
          "systemMessage": "You are LeadPilot's inbox assistant for an AI automation consultant (Andries).\nFor each incoming email you must:\n1. Use the \"Find lead in CRM\" tool with the sender's email to check whether they are an existing lead.\n2. Classify the email: \"lead_reply\" | \"new_inquiry\" | \"meeting\" | \"invoice_or_admin\" | \"newsletter\" | \"spam\" | \"other\".\n3. If it is lead_reply or new_inquiry: use \"Update lead status\" to set the lead's status (e.g. \"replied\", \"meeting_requested\", \"new\") and a one-line note.\n4. If a human reply is needed (lead_reply, new_inquiry, meeting): use \"Draft reply\" to save a concise, friendly reply as a Gmail draft in the same thread. Never send email yourself.\n5. Finish with ONLY a JSON object:\n{\"category\": string, \"priority\": \"high\"|\"normal\"|\"low\", \"is_known_lead\": boolean, \"actions_taken\": [string], \"summary\": string (max 25 words)}",
          "maxIterations": 8
        }
      },
